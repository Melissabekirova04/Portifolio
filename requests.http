### ============================================================
### US5 - SØG EFTER FLY
### ============================================================

### US5.1 - Søg efter flybilletter
# Forventet: 200 ved vellykket søgning.
# Kontrollér offers, flyselskab, pris og datoer.
POST {{baseUrl}}/api/flights/search
Authorization: Bearer {{us1token}}
Accept: application/json

> {%
    if (response.status === 200 && response.body.offers &&
        response.body.offers.length > 0) {
        client.global.set("flightOfferId", response.body.offers[0].id);
    }
%}


### ============================================================
### US6 - SAMMENLIGN FLYAFGANGE
### ============================================================

### US6.1 - Hent flyresultater til sammenligning
# Kontrollér pris, flyselskab, afgangstid,
# ankomsttid, rejsetid og mellemlandinger.
POST {{baseUrl}}/api/flights/search
Authorization: Bearer {{us1token}}
Accept: application/json


### ============================================================
### US7 - GEM FLY PÅ REJSEN
### ============================================================

### US7.1 - Gem valgt fly
# Body-feltet skal bekræftes i FlightController/TripController.
# Her anvendes offerId som kandidat.
POST {{baseUrl}}/api/trip-draft/flight
Authorization: Bearer {{us1token}}
Content-Type: application/json

{
  "offerId": "{{flightOfferId}}"
}


### US7.2 - Kontrollér gemt fly
# Forventet: 200, og flight er ikke null.
GET {{baseUrl}}/api/trip-draft
Authorization: Bearer {{us1token}}
Accept: application/json


### ============================================================
### US8 - SØG EFTER HOTELLER
### ============================================================

### US8.1 - Søg efter hoteller - forvent 200
# Fra HotelController: POST /api/hotels/search.
# Forvent offers, currency=DKK og testData=true.
POST {{baseUrl}}/api/hotels/search
Authorization: Bearer {{us1token}}
Accept: application/json

> {%
    if (response.status === 200 &&
        response.body.offers &&
        response.body.offers.length > 0) {
        client.global.set("hotelId", response.body.offers[0].id);
    }
%}


### US8.2 - Hotelsøgning uden JWT - forvent 401
POST {{baseUrl}}/api/hotels/search
Accept: application/json


### ============================================================
### US9 - SAMMENLIGN OG VÆLG HOTEL
### ============================================================

### US9.1 - Gem valgt hotel - forvent 200
# Kræver at US8.1 er kørt først.
POST {{baseUrl}}/api/trip-draft/hotel
Authorization: Bearer {{us1token}}
Content-Type: application/json

{
  "hotelId": "{{hotelId}}"
}


### US9.2 - Se samlet pris med valgt hotel - forvent 200
GET {{baseUrl}}/api/trip-draft/summary
Authorization: Bearer {{us1token}}
Accept: application/json


### US9.3 - Fjern valgt hotel - forvent 200
DELETE {{baseUrl}}/api/trip-draft/hotel
Authorization: Bearer {{us1token}}
Accept: application/json


### US9.4 - Kontrollér at hotel er fjernet - forvent 200
# Hotel skal være null.
GET {{baseUrl}}/api/trip-draft/summary
Authorization: Bearer {{us1token}}
Accept: application/json


